{
    "name": "Aria",
    "scopeName": "source.aria",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#words" },
        { "include": "#operators" },
        { "include": "#punctuation" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                { "name": "comment.line.double-slash.aria", "match": "//.*$" },
                { "name": "comment.block.aria", "begin": "/\\*", "end": "\\*/" }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.triple.aria",
                    "begin": "\"\"\"",
                    "end": "\"\"\"",
                    "patterns": [
                        { "include": "#escape" },
                        { "include": "#interpolation" }
                    ]
                },
                {
                    "name": "string.quoted.double.aria",
                    "begin": "\"",
                    "end": "\"|$",
                    "patterns": [
                        { "include": "#escape" },
                        { "include": "#interpolation" }
                    ]
                },
                {
                    "name": "string.quoted.single.aria",
                    "begin": "'",
                    "end": "'|$",
                    "patterns": [{ "include": "#escape" }]
                }
            ]
        },
        "escape": {
            "name": "constant.character.escape.aria",
            "match": "\\\\."
        },
        "interpolation": {
            "name": "meta.embedded.expression.aria",
            "begin": "\\{",
            "end": "\\}",
            "patterns": [
                { "include": "#nested-braces" },
                { "include": "$self" }
            ]
        },
        "nested-braces": {
            "begin": "\\{",
            "end": "\\}",
            "patterns": [
                { "include": "#nested-braces" },
                { "include": "$self" }
            ]
        },
        "numbers": {
            "patterns": [
                { "name": "constant.numeric.hex.aria", "match": "\\b0[xX][\\da-fA-F]+\\b" },
                { "name": "constant.numeric.binary.aria", "match": "\\b0[bB][01]+\\b" },
                { "name": "constant.numeric.octal.aria", "match": "\\b0[oO][0-7]+\\b" },
                { "name": "constant.numeric.float.aria", "match": "(?<![\\w.])(?:\\d*\\.\\d+(?:[eE][-+]?\\d+)?|\\d+[eE][-+]?\\d+)\\b" },
                { "name": "constant.numeric.integer.aria", "match": "\\b\\d+\\b" }
            ]
        },
        "words": {
            "patterns": [
                {
                    "match": "\\b(class|extends)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
                    "captures": {
                        "1": { "name": "keyword.control.aria" },
                        "2": { "name": "entity.name.class.aria" }
                    }
                },
                {
                    "name": "keyword.control.aria",
                    "match": "\\b(if|elif|else|while|for|in|switch|match|case|break|next|return|throw|try|catch|finally|import|export|from|as|async|await|class|extends|super|new|instanceof)\\b"
                },
                { "name": "storage.type.aria", "match": "(?<!\\.)\\b(var|val|global|server|client)(?=\\.)|(?<!\\.)\\bself\\b" },
                { "name": "variable.other.args.aria", "match": "(?<!\\.)\\bargs\\b" },
                { "name": "constant.language.boolean.aria", "match": "\\b(true|false)\\b" },
                { "name": "constant.language.null.aria", "match": "\\bnone\\b" },
                {
                    "name": "support.class.aria",
                    "match": "\\b(Aria|Math|Player|Cast|Chat|Display|Entity|Fog|Game|Keyboard|Message|Name|Packet|Placeholder|Potion|Screen|Shader|Skybox|Sound|Thread|Time|Web|Mouse|Camera|Tip)\\b(?=\\.)"
                },
                {
                    "name": "support.function.aria",
                    "match": "(?<!\\.)\\b(range|print|println|use|Lerp|Back|Bezier|Bounce|CircX|CircY|Elastic|Expo|Q2|Q3|Q4|Q5|Sine|Smooth|Spring|Fade|TwoLerp|Blink|Breathe|Pulse|Shake|Swing|Wave|Slide)\\b(?=\\s*\\()"
                },
                {
                    "name": "entity.name.function.aria",
                    "match": "(?<![\\p{L}\\p{N}_])[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()"
                }
            ]
        },
        "operators": {
            "patterns": [
                { "name": "keyword.operator.other.aria", "match": "->|\\.\\.\\.|\\?\\.|\\?\\?|\\?:" },
                { "name": "keyword.operator.assignment.aria", "match": ">>>=|>>=|<<=|[+*/%&|^~-]=" },
                { "name": "keyword.operator.other.aria", "match": ">>>|>>|<<" },
                { "name": "keyword.operator.comparison.aria", "match": "~~|==|!=|<=|>=|<|>" },
                { "name": "keyword.operator.assignment.aria", "match": "=" },
                { "name": "keyword.operator.logical.aria", "match": "&&|\\|\\||!" },
                { "name": "keyword.operator.arithmetic.aria", "match": "\\+\\+|--|[+*/%-]" },
                { "name": "keyword.operator.other.aria", "match": "[&|^~?]" }
            ]
        },
        "punctuation": {
            "patterns": [
                { "name": "punctuation.bracket.aria", "match": "[{}()\\[\\]]" },
                { "name": "punctuation.separator.aria", "match": "[,;.:]" }
            ]
        }
    }
}
