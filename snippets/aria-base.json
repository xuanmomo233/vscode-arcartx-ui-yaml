{
  "基础: 变量": {
    "prefix": ["var."],
    "body": [
      "var"
    ],
    "description": "可变变量"
  },
  "基础: 宿主注入值": {
    "prefix": ["val."],
    "body": [
      "val"
    ],
    "description": "读取宿主注入的只读值"
  },
  "基础: 全局变量": {
    "prefix": ["global."],
    "body": [
      "global"
    ],
    "description": "全局变量"
  },
  "基础: 客户端变量": {
    "prefix": ["client."],
    "body": [
      "client"
    ],
    "description": "客户端变量"
  },
  "基础: 服务端变量": {
    "prefix": ["server."],
    "body": [
      "server"
    ],
    "description": "服务器变量"
  },
  "基础: 当前对象": {
    "prefix": ["self"],
    "body": [
      "self"
    ],
    "description": "当前对象"
  },
  "基础: 参数": {
    "prefix": ["args"],
    "body": [
      "args[${1:index}]"
    ],
    "description": "参数"
  },
  "基础: 参数数量": {
    "prefix": "args.length",
    "body": ["args.length"],
    "description": "获取函数参数数量"
  },
  "基础: 条件语句": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "\t${2}",
      "}"
    ],
    "description": "条件语句"
  },
  "基础: 条件语句（带else）": {
    "prefix": "ifelse",
    "body": [
      "if (${1:condition}) {",
      "\t${2}",
      "} else {",
      "\t${3}",
      "}"
    ],
    "description": "条件语句（带else）"
  },
  "基础: for-in循环": {
    "prefix": "for",
    "body": [
      "for (${1:item} in ${2:items}) {",
      "\t${3}",
      "}"
    ],
    "description": "for-in循环"
  },
  "基础: while循环": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "\t${2}",
      "}"
    ],
    "description": "while循环"
  },
  "基础: switch语句": {
    "prefix": "switch",
    "body": [
      "switch (${1:expression}) {",
      "\tcase ${2:value} {",
      "\t\t${3}",
      "\t}",
      "\telse {",
      "\t\t${4}",
      "\t}",
      "}"
    ],
    "description": "switch语句"
  },
  "基础: case分支": {
    "prefix": "case",
    "body": [
      "case ${1:value} {",
      "\t${2}",
      "}"
    ],
    "description": "case分支"
  },
  "基础: match 分支": {
    "prefix": "match",
    "body": [
      "match (${1:expression}) {",
      "\tcase ${2:value} {",
      "\t\t$3",
      "\t}",
      "\telse {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "执行第一个匹配的分支"
  },
  "基础: 箭头函数": {
    "prefix": "fn",
    "body": [
      "var.${1:name} = -> {",
      "\t$0",
      "}"
    ],
    "description": "定义函数，使用 args[index] 读取参数"
  },
  "基础: 异常处理": {
    "prefix": "try",
    "body": [
      "try {",
      "\t$1",
      "} catch (${2:error}) {",
      "\t$0",
      "}"
    ],
    "description": "捕获异常，可按需添加 finally"
  },
  "基础: 类声明": {
    "prefix": "class",
    "body": [
      "class ${1:ClassName} {",
      "\tnew = -> {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "声明 Aria 类及其构造函数"
  },
  "模块: 命名导入": {
    "prefix": "importfrom",
    "body": ["import { ${1:symbol} } from '${2:module}'"],
    "description": "从 Aria 模块导入指定符号"
  },
  "模块: 导出函数": {
    "prefix": "exportfn",
    "body": [
      "export var.${1:name} = -> {",
      "\t$0",
      "}"
    ],
    "description": "导出 Aria 模块函数"
  },
  "基础: 异步代码块": {
    "prefix": "async",
    "body": [
      "async {",
      "\t${1}",
      "}"
    ],
    "description": "异步代码块"
  },
  "基础: 等待异步结果": {
    "prefix": "await",
    "body": ["await ${1:promise}"],
    "description": "等待 async 返回的 Promise"
  },
  "基础: 可选链和空值合并": {
    "prefix": "nullish",
    "body": ["${1:object}?.${2:field} ?? ${3:fallback}"],
    "description": "安全访问成员并在结果为 none 时使用默认值"
  },
  "基础: 创建数字范围": {
    "prefix": "range",
    "body": [
      "range(${1:start}, ${2:end})"
    ],
    "description": "创建数字范围"
  },
  "基础: 范围判断": {
    "prefix": "~r",
    "body": [
        "~~ range(${1:start}, ${2:end})"
    ],
    "description": "范围判断"
  }
}
